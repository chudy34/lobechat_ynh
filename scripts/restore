#!/bin/bash

source "$(dirname "$0")/_common.sh"
source /usr/share/yunohost/helpers

#=================================================
# ENSURE DOCKER CE
#=================================================
ynh_script_progression --message="Checking Docker CE..." --weight=10
install_docker_ce

#=================================================
# RESTORE FILES
#=================================================
ynh_script_progression --message="Restoring install dir..." --weight=5
ynh_restore_file --origin_path="$install_dir"

ynh_script_progression --message="Restoring data..." --weight=20
ynh_restore_file --origin_path="$data_dir/backups"
ynh_restore_file --origin_path="$data_dir/redis"
ynh_restore_file --origin_path="$data_dir/rustfs"
ynh_restore_file --origin_path="$data_dir/searxng"

ynh_script_progression --message="Repairing data permissions..." --weight=2
prepare_data_dirs

#=================================================
# PULL IMAGES & START
#=================================================
ynh_script_progression --message="Pulling Docker images..." --weight=40

cd "$install_dir" || ynh_die "Unable to enter install directory: $install_dir"
docker compose --project-name "$app" pull

ynh_script_progression --message="Restoring systemd and nginx..." --weight=2
ynh_restore_file --origin_path="/etc/systemd/system/$app.service"
systemctl daemon-reload
ynh_restore_file --origin_path="/etc/nginx/conf.d/$domain.d/$app.conf"

ynh_script_progression --message="Starting PostgreSQL for database restore..." --weight=5
# Start PostgreSQL on its own. LobeHub must remain stopped until the database
# import is complete, otherwise it can run migrations or serve an empty DB.
docker compose --project-name "$app" --file "$install_dir/docker-compose.yml" \
    up -d postgresql

ynh_script_progression --message="Waiting for PostgreSQL..." --weight=5
pg_ready=0
for _ in $(seq 1 150); do
    if docker compose --project-name "$app" --file "$install_dir/docker-compose.yml" \
        exec -T postgresql pg_isready -U postgres >/dev/null 2>&1; then
        pg_ready=1
        break
    fi
    sleep 2
done

if [ "$pg_ready" != "1" ]; then
    ynh_die "PostgreSQL did not become ready within 300 seconds; refusing to skip database restore."
fi

restore_postgres "$data_dir/backups/postgres_dump.sql"

ynh_script_progression --message="Starting restored LobeHub..." --weight=10
# Use restart because the restored oneshot unit may still be active according
# to systemd even if one or more containers are not running.
systemctl restart "$app" || true
sleep 5

ynh_script_progression --message="Waiting for LobeHub to be ready..." --weight=5
wait_for_lobehub 900

ynh_script_progression --message="Restore complete!" --last
